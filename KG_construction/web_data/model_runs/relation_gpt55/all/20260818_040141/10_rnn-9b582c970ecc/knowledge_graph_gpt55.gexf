          <attvalue for="7" value="[&quot;Gradient methods always converge to the global minimum&quot;, &quot;The learning rate can be arbitrary&quot;]" />
          <attvalue for="8" value="[&quot;Training neural networks&quot;, &quot;Optimizing logistic regression models&quot;]" />
        </attvalues>
      </node>
