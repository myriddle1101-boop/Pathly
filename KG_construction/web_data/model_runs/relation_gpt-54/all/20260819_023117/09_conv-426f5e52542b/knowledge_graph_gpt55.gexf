    <nodes>
      <node id="Convolutional Networks" label="Convolutional Networks">
        <attvalues>
          <attvalue for="0" value="A class of deep neural networks primarily used for processing structured grid data such as images." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Convolutional Layer&quot;, &quot;description&quot;: &quot;The layer in a convolutional network that applies convolution operations to the input.&quot;}, {&quot;name&quot;: &quot;Convolution Kernel&quot;, &quot;description&quot;: &quot;A filter used in convolutional layers to extract features from input data.&quot;}, {&quot;name&quot;: &quot;Pooling&quot;, &quot;description&quot;: &quot;A down-sampling operation that reduces the spatial dimensions of the input.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of neural networks and linear algebra." />
          <attvalue for="6" value="[&quot;Convolutional layers&quot;, &quot;Pooling layers&quot;, &quot;Activation functions&quot;, &quot;Fully connected layers&quot;]" />
          <attvalue for="7" value="[&quot;Convolutional networks only work for images&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Object detection&quot;, &quot;Facial recognition&quot;, &quot;Medical image analysis&quot;]" />
        </attvalues>
      </node>
      <node id="Matrices" label="Matrices">
        <attvalues>
          <attvalue for="0" value="Mathematical structures used to represent data and perform operations in machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Matrix Multiplication&quot;, &quot;description&quot;: &quot;An operation that produces a new matrix from two matrices.&quot;}, {&quot;name&quot;: &quot;Matrix Transpose&quot;, &quot;description&quot;: &quot;An operation that flips a matrix over its diagonal.&quot;}, {&quot;name&quot;: &quot;Sparse Matrices&quot;, &quot;description&quot;: &quot;Matrices in which most elements are zero, often used in machine learning.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of algebra and functions." />
          <attvalue for="6" value="[&quot;Matrix addition and subtraction&quot;, &quot;Matrix multiplication&quot;, &quot;Determinants and inverses&quot;, &quot;Eigenvalues and eigenvectors&quot;]" />
          <attvalue for="7" value="[&quot;All matrices can be multiplied regardless of their dimensions&quot;, &quot;Matrix operations are commutative&quot;]" />
          <attvalue for="8" value="[&quot;Data representation in machine learning&quot;, &quot;Transformations in computer graphics&quot;, &quot;Solving systems of linear equations&quot;, &quot;Principal Component Analysis (PCA)&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Computational models inspired by the human brain, consisting of interconnected neurons." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Activation Function&quot;, &quot;description&quot;: &quot;A function that determines the output of a neuron based on its input.&quot;}, {&quot;name&quot;: &quot;Backpropagation&quot;, &quot;description&quot;: &quot;An algorithm for training neural networks by minimizing the error.&quot;}, {&quot;name&quot;: &quot;Deep Learning&quot;, &quot;description&quot;: &quot;A subset of machine learning that uses neural networks with many layers.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Learning Algorithms" label="Learning Algorithms">
        <attvalues>
          <attvalue for="0" value="Procedures used to train models and make predictions based on data." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Supervised Learning&quot;, &quot;description&quot;: &quot;A type of learning where the model is trained on labeled data.&quot;}, {&quot;name&quot;: &quot;Unsupervised Learning&quot;, &quot;description&quot;: &quot;A type of learning where the model finds patterns in unlabeled data.&quot;}, {&quot;name&quot;: &quot;Reinforcement Learning&quot;, &quot;description&quot;: &quot;A type of learning where an agent learns to make decisions by receiving rewards.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and programming." />
          <attvalue for="6" value="[&quot;Supervised Learning&quot;, &quot;Unsupervised Learning&quot;]" />
          <attvalue for="7" value="[&quot;All algorithms work the same for every problem&quot;, &quot;More data always leads to better models&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Predictive analytics&quot;]" />
        </attvalues>
      </node>
      <node id="Feature Learning" label="Feature Learning">
        <attvalues>
          <attvalue for="0" value="The process of automatically discovering the representations needed for feature detection or classification." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Learned Filters&quot;, &quot;description&quot;: &quot;Filters that are optimized during training to extract relevant features.&quot;}, {&quot;name&quot;: &quot;Invariances&quot;, &quot;description&quot;: &quot;Properties that remain unchanged under certain transformations.&quot;}, {&quot;name&quot;: &quot;Local Connections&quot;, &quot;description&quot;: &quot;Connections in neural networks that are limited to a local region of the input.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning and linear algebra." />
          <attvalue for="6" value="[&quot;Representation Learning&quot;, &quot;Deep Learning&quot;]" />
          <attvalue for="7" value="[&quot;Feature learning is only for deep learning models.&quot;, &quot;Feature learning eliminates the need for domain knowledge.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Training Techniques" label="Training Techniques">
        <attvalues>
          <attvalue for="0" value="Methods and strategies used to improve the performance of machine learning models." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Loss Function&quot;, &quot;description&quot;: &quot;A function that measures the difference between predicted and actual outcomes.&quot;}, {&quot;name&quot;: &quot;Regularization&quot;, &quot;description&quot;: &quot;Techniques used to prevent overfitting in machine learning models.&quot;}, {&quot;name&quot;: &quot;Gradient Descent&quot;, &quot;description&quot;: &quot;An optimization algorithm used to minimize the loss function.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and algorithms." />
          <attvalue for="6" value="[&quot;Cross-validation&quot;, &quot;Regularization&quot;, &quot;Hyperparameter tuning&quot;, &quot;Data augmentation&quot;]" />
          <attvalue for="7" value="[&quot;More data always leads to better performance&quot;, &quot;Overfitting only occurs with complex models&quot;]" />
          <attvalue for="8" value="[&quot;Improving model accuracy&quot;, &quot;Reducing overfitting&quot;, &quot;Enhancing generalization to unseen data&quot;]" />
        </attvalues>
      </node>
      <node id="Data Representation" label="Data Representation">
        <attvalues>
          <attvalue for="0" value="The way data is structured and formatted for processing in machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Vectors&quot;, &quot;description&quot;: &quot;Ordered arrays of numbers used to represent data points.&quot;}, {&quot;name&quot;: &quot;Tensors&quot;, &quot;description&quot;: &quot;Generalized arrays that can represent data in multiple dimensions.&quot;}, {&quot;name&quot;: &quot;Pixel Labeling&quot;, &quot;description&quot;: &quot;The process of assigning labels to individual pixels in an image.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
