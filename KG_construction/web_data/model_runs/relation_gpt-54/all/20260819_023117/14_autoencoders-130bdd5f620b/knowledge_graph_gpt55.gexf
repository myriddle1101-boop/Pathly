          <attvalue for="1" value="[{&quot;name&quot;: &quot;Input Reconstruction&quot;, &quot;description&quot;: &quot;The task of reconstructing the original input from the encoded representation.&quot;}, {&quot;name&quot;: &quot;Reconstructed Input&quot;, &quot;description&quot;: &quot;The output generated by the decoder in an autoencoder.&quot;}]" />
