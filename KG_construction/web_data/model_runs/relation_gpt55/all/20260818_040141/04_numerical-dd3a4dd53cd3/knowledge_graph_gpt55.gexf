    <nodes>
      <node id="Gradient Descent" label="Gradient Descent">
        <attvalues>
          <attvalue for="0" value="A fundamental optimization algorithm used to minimize functions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Negative Gradient&quot;, &quot;description&quot;: &quot;The direction of steepest descent in optimization.&quot;}, {&quot;name&quot;: &quot;Curvature Function&quot;, &quot;description&quot;: &quot;Measures the curvature of the loss function.&quot;}, {&quot;name&quot;: &quot;Learning Rate&quot;, &quot;description&quot;: &quot;Controls the step size during optimization.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus and linear algebra." />
          <attvalue for="6" value="[&quot;Learning Rate&quot;, &quot;Convergence&quot;, &quot;Stochastic Gradient Descent&quot;, &quot;Batch Gradient Descent&quot;]" />
          <attvalue for="7" value="[&quot;Gradient descent always finds the global minimum.&quot;, &quot;A smaller learning rate is always better.&quot;]" />
          <attvalue for="8" value="[&quot;Training machine learning models&quot;, &quot;Optimizing neural networks&quot;]" />
        </attvalues>
      </node>
      <node id="Eigenvalues and Eigenvectors" label="Eigenvalues and Eigenvectors">
        <attvalues>
          <attvalue for="0" value="Key concepts in linear algebra used in various machine learning algorithms." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Eigendecomposition&quot;, &quot;description&quot;: &quot;The process of decomposing a matrix into its eigenvalues and eigenvectors.&quot;}, {&quot;name&quot;: &quot;Covariance Matrix&quot;, &quot;description&quot;: &quot;A matrix that describes the variance and correlation between variables.&quot;}, {&quot;name&quot;: &quot;Principal Component Analysis&quot;, &quot;description&quot;: &quot;A technique that uses eigenvalues and eigenvectors for dimensionality reduction.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, including matrices and vectors." />
          <attvalue for="6" value="[&quot;Matrix decomposition&quot;, &quot;Spectral theorem&quot;]" />
          <attvalue for="7" value="[&quot;Eigenvalues are always positive&quot;, &quot;Eigenvectors are unique&quot;]" />
          <attvalue for="8" value="[&quot;Principal Component Analysis (PCA)&quot;, &quot;Dimensionality reduction&quot;]" />
        </attvalues>
      </node>
      <node id="Optimization Techniques" label="Optimization Techniques">
        <attvalues>
          <attvalue for="0" value="Methods used to find the best parameters for machine learning models." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Minimization&quot;, &quot;description&quot;: &quot;The process of finding the minimum value of a function.&quot;}, {&quot;name&quot;: &quot;Maximization&quot;, &quot;description&quot;: &quot;The process of finding the maximum value of a function.&quot;}, {&quot;name&quot;: &quot;Convergence Criteria&quot;, &quot;description&quot;: &quot;Conditions that determine when an optimization algorithm should stop.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus and linear algebra, familiarity with machine learning concepts." />
          <attvalue for="6" value="[&quot;Gradient Descent&quot;, &quot;Stochastic Gradient Descent&quot;, &quot;Newton's Method&quot;, &quot;Regularization Techniques&quot;]" />
          <attvalue for="7" value="[&quot;Optimization guarantees the best model performance&quot;, &quot;All optimization techniques are equally effective for every problem&quot;]" />
          <attvalue for="8" value="[&quot;Tuning hyperparameters in neural networks&quot;, &quot;Improving convergence in logistic regression&quot;, &quot;Feature selection in supervised learning&quot;]" />
        </attvalues>
      </node>
      <node id="Curvature Analysis" label="Curvature Analysis">
        <attvalues>
          <attvalue for="0" value="The study of the curvature of functions to understand optimization landscapes." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Negative Curvature&quot;, &quot;description&quot;: &quot;Indicates a local maximum in the optimization landscape.&quot;}, {&quot;name&quot;: &quot;Curvature Gradient&quot;, &quot;description&quot;: &quot;The gradient of the curvature function.&quot;}, {&quot;name&quot;: &quot;Stationary Points&quot;, &quot;description&quot;: &quot;Points where the gradient is zero, indicating potential minima or maxima.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus and optimization techniques." />
          <attvalue for="6" value="[&quot;Hessian matrix&quot;, &quot;Second derivative test&quot;]" />
          <attvalue for="7" value="[&quot;Curvature only applies to convex functions&quot;, &quot;Curvature analysis is not relevant for non-convex optimization&quot;]" />
          <attvalue for="8" value="[&quot;Improving convergence in optimization algorithms&quot;, &quot;Analyzing the stability of critical points in machine learning models&quot;]" />
        </attvalues>
      </node>
      <node id="Partial Derivatives" label="Partial Derivatives">
        <attvalues>
          <attvalue for="0" value="Derivatives of functions with respect to one variable while keeping others constant." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Gradient Vector&quot;, &quot;description&quot;: &quot;A vector of partial derivatives indicating the direction of steepest ascent.&quot;}, {&quot;name&quot;: &quot;Critical Points&quot;, &quot;description&quot;: &quot;Points where the gradient is zero or undefined.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus and multivariable functions." />
          <attvalue for="6" value="[&quot;Multivariable functions&quot;, &quot;Gradient vector&quot;]" />
          <attvalue for="7" value="[&quot;Partial derivatives can be used for all types of functions&quot;, &quot;Partial derivatives are the same as total derivatives&quot;]" />
          <attvalue for="8" value="[&quot;Optimization problems in machine learning&quot;, &quot;Sensitivity analysis in engineering&quot;]" />
        </attvalues>
      </node>
      <node id="Training Neural Networks" label="Training Neural Networks">
