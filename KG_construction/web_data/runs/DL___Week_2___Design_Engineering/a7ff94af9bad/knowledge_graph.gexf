    <nodes>
      <node id="Artificial Neural Networks" label="Artificial Neural Networks">
        <attvalues>
          <attvalue for="0" value="A computational model inspired by the way biological neural networks in the human brain process information." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Neurons&quot;, &quot;description&quot;: &quot;Basic units of artificial neural networks that process input and produce output.&quot;}, {&quot;name&quot;: &quot;Activation Functions&quot;, &quot;description&quot;: &quot;Functions that determine the output of a neuron based on its input.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, calculus, and programming." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image and speech recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Backpropagation" label="Backpropagation">
        <attvalues>
          <attvalue for="0" value="A supervised learning algorithm used for training artificial neural networks by minimizing the error." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Loss Function&quot;, &quot;description&quot;: &quot;A function that measures the difference between predicted and actual outcomes.&quot;}, {&quot;name&quot;: &quot;Gradient Descent&quot;, &quot;description&quot;: &quot;An optimization algorithm used to minimize the loss function during training.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus, linear algebra, and neural networks." />
          <attvalue for="6" value="[&quot;Gradient Descent&quot;, &quot;Chain Rule&quot;, &quot;Loss Function&quot;]" />
          <attvalue for="7" value="[&quot;Backpropagation is the same as training a neural network.&quot;, &quot;It only works for feedforward networks.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Linear Separation" label="Linear Separation">
        <attvalues>
          <attvalue for="0" value="A concept in machine learning where data points can be separated by a linear boundary." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Linearly Separable&quot;, &quot;description&quot;: &quot;A condition where two classes can be separated by a straight line.&quot;}, {&quot;name&quot;: &quot;Linear Regression&quot;, &quot;description&quot;: &quot;A statistical method for modeling the relationship between a dependent variable and one or more independent variables.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and statistics." />
          <attvalue for="6" value="[&quot;Hyperplanes&quot;, &quot;Support Vector Machines&quot;]" />
          <attvalue for="7" value="[&quot;Linear separation is always possible for any dataset.&quot;, &quot;Only two-dimensional data can be linearly separated.&quot;]" />
          <attvalue for="8" value="[&quot;Binary classification tasks&quot;, &quot;Image recognition&quot;]" />
        </attvalues>
      </node>
      <node id="Training Techniques" label="Training Techniques">
        <attvalues>
          <attvalue for="0" value="Methods and strategies used to train machine learning models effectively." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Supervised Learning&quot;, &quot;description&quot;: &quot;A type of learning where the model is trained on labeled data.&quot;}, {&quot;name&quot;: &quot;Unsupervised Learning&quot;, &quot;description&quot;: &quot;A type of learning where the model is trained on unlabeled data.&quot;}]" />
