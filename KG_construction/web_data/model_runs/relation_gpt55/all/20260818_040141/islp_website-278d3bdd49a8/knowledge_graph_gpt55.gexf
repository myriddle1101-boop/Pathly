    <nodes>
      <node id="Regression" label="Regression">
        <attvalues>
          <attvalue for="0" value="A statistical method for modeling the relationship between a dependent variable and one or more independent variables." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Linear Regression&quot;, &quot;description&quot;: &quot;A type of regression analysis that models the relationship using a linear equation.&quot;}, {&quot;name&quot;: &quot;Logistic Regression&quot;, &quot;description&quot;: &quot;A regression model used for binary classification tasks.&quot;}, {&quot;name&quot;: &quot;Ridge Regression&quot;, &quot;description&quot;: &quot;A technique used to analyze multiple regression data that suffer from multicollinearity.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and algebra." />
          <attvalue for="6" value="[&quot;Linear Regression&quot;, &quot;Multiple Regression&quot;]" />
          <attvalue for="7" value="[&quot;Regression implies causation&quot;, &quot;Only linear relationships can be modeled&quot;]" />
          <attvalue for="8" value="[&quot;Predicting sales based on advertising spend&quot;, &quot;Estimating housing prices based on features&quot;]" />
        </attvalues>
      </node>
      <node id="Statistical Learning" label="Statistical Learning">
        <attvalues>
          <attvalue for="0" value="A framework for understanding and applying statistical methods to learn from data." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Model Selection&quot;, &quot;description&quot;: &quot;The process of selecting a statistical model from a set of candidate models.&quot;}, {&quot;name&quot;: &quot;Hypothesis Testing&quot;, &quot;description&quot;: &quot;A method for testing a hypothesis about a parameter in a statistical model.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and probability." />
          <attvalue for="6" value="[&quot;Supervised Learning&quot;, &quot;Unsupervised Learning&quot;]" />
          <attvalue for="7" value="[&quot;Statistical learning is only about regression.&quot;, &quot;More data always leads to better models.&quot;]" />
          <attvalue for="8" value="[&quot;Predictive modeling in finance&quot;, &quot;Customer segmentation in marketing&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Computational models inspired by the human brain, used for various machine learning tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Artificial Neural Network&quot;, &quot;description&quot;: &quot;A network of algorithms that attempts to recognize underlying relationships in a set of data.&quot;}, {&quot;name&quot;: &quot;Activation Function&quot;, &quot;description&quot;: &quot;A mathematical function that determines the output of a neural network node.&quot;}, {&quot;name&quot;: &quot;Backpropagation&quot;, &quot;description&quot;: &quot;An algorithm for training neural networks by minimizing the error.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;, &quot;Loss Functions&quot;, &quot;Overfitting and Regularization&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image and speech recognition&quot;, &quot;Natural language processing&quot;, &quot;Game playing AI&quot;, &quot;Medical diagnosis&quot;]" />
        </attvalues>
      </node>
      <node id="Support Vector Machines" label="Support Vector Machines">
        <attvalues>
          <attvalue for="0" value="A supervised learning model used for classification and regression analysis." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Hyperplane&quot;, &quot;description&quot;: &quot;A decision boundary that separates different classes in a support vector machine.&quot;}, {&quot;name&quot;: &quot;Margin&quot;, &quot;description&quot;: &quot;The distance between the hyperplane and the nearest data point from either class.&quot;}]" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and statistics." />
          <attvalue for="6" value="[&quot;Hyperplanes&quot;, &quot;Kernel functions&quot;]" />
          <attvalue for="7" value="[&quot;SVMs can only be used for linear classification&quot;, &quot;More support vectors always lead to better models&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Text categorization&quot;]" />
        </attvalues>
      </node>
      <node id="Clustering" label="Clustering">
        <attvalues>
          <attvalue for="0" value="A method of grouping a set of objects in such a way that objects in the same group are more similar than those in other groups." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Hierarchical Clustering&quot;, &quot;description&quot;: &quot;A method of cluster analysis that seeks to build a hierarchy of clusters.&quot;}, {&quot;name&quot;: &quot;K-Means Clustering&quot;, &quot;description&quot;: &quot;A partitioning method that divides a dataset into K distinct non-overlapping subsets.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and linear algebra." />
          <attvalue for="6" value="[&quot;K-means clustering&quot;, &quot;Hierarchical clustering&quot;]" />
          <attvalue for="7" value="[&quot;Clustering is the same as classification&quot;, &quot;All clustering algorithms produce the same results&quot;]" />
          <attvalue for="8" value="[&quot;Market segmentation&quot;, &quot;Image compression&quot;]" />
        </attvalues>
      </node>
      <node id="Model Evaluation" label="Model Evaluation">
        <attvalues>
          <attvalue for="0" value="The process of assessing the performance of a machine learning model." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Error Rate&quot;, &quot;description&quot;: &quot;The proportion of incorrect predictions made by a model.&quot;}, {&quot;name&quot;: &quot;Model Accuracy&quot;, &quot;description&quot;: &quot;The ratio of correctly predicted instances to the total instances.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and algorithms." />
          <attvalue for="6" value="[&quot;Accuracy&quot;, &quot;Precision and Recall&quot;, &quot;F1 Score&quot;, &quot;ROC Curve&quot;, &quot;Cross-Validation&quot;]" />
          <attvalue for="7" value="[&quot;Higher accuracy always means a better model&quot;, &quot;Overfitting is not a concern if the model performs well on training data&quot;]" />
          <attvalue for="8" value="[&quot;Evaluating classification models&quot;, &quot;Comparing different models&quot;, &quot;Tuning hyperparameters&quot;]" />
        </attvalues>
      </node>
      <node id="Survival Analysis" label="Survival Analysis">
        <attvalues>
          <attvalue for="0" value="A set of statistical approaches for data analysis where the outcome variable is the time until an event occurs." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Survival Function&quot;, &quot;description&quot;: &quot;A function that estimates the probability of survival beyond a certain time.&quot;}, {&quot;name&quot;: &quot;Hazard Function&quot;, &quot;description&quot;: &quot;A function that describes the instantaneous risk of the event occurring.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and probability, familiarity with regression analysis." />
          <attvalue for="6" value="[&quot;Censoring&quot;, &quot;Kaplan-Meier Estimator&quot;, &quot;Cox Proportional Hazards Model&quot;]" />
          <attvalue for="7" value="[&quot;Survival analysis only applies to medical data&quot;, &quot;Time-to-event data must be normally distributed&quot;]" />
          <attvalue for="8" value="[&quot;Clinical trials&quot;, &quot;Reliability engineering&quot;, &quot;Customer churn analysis&quot;]" />
        </attvalues>
      </node>
      <node id="Regression Trees" label="Regression Trees">
        <attvalues>
          <attvalue for="0" value="A decision tree that predicts a continuous value based on input features." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Decision Trees&quot;, &quot;description&quot;: &quot;A flowchart-like structure used for classification and regression.&quot;}, {&quot;name&quot;: &quot;Regression Splines&quot;, &quot;description&quot;: &quot;A flexible method for fitting a regression model using piecewise polynomial functions.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and decision trees." />
          <attvalue for="6" value="[&quot;Splitting criteria&quot;, &quot;Pruning techniques&quot;]" />
          <attvalue for="7" value="[&quot;Regression trees can only predict linear relationships&quot;, &quot;More splits always lead to better predictions&quot;]" />
          <attvalue for="8" value="[&quot;House price prediction&quot;, &quot;Sales forecasting&quot;]" />
        </attvalues>
      </node>
      <node id="Predictors" label="Predictors">
        <attvalues>
          <attvalue for="0" value="Variables that are used to predict the outcome of a dependent variable." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Predictor Variables&quot;, &quot;description&quot;: &quot;Independent variables used in regression models.&quot;}, {&quot;name&quot;: &quot;Coefficients&quot;, &quot;description&quot;: &quot;Values that represent the relationship between predictors and the response variable.&quot;}]" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and algebra." />
          <attvalue for="6" value="[&quot;Independent variables&quot;, &quot;Feature selection&quot;]" />
          <attvalue for="7" value="[&quot;All predictors are equally important&quot;, &quot;More predictors always lead to better predictions&quot;]" />
          <attvalue for="8" value="[&quot;Predicting house prices&quot;, &quot;Forecasting sales trends&quot;]" />
        </attvalues>
      </node>
