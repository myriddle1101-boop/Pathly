      <node id="Bias in AI" label="Bias in AI">
        <attvalues>
          <attvalue for="0" value="Explores various aspects of bias in artificial intelligence systems." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Types of Bias&quot;, &quot;description&quot;: &quot;Different categories and manifestations of bias in AI.&quot;}, {&quot;name&quot;: &quot;Mitigating Bias&quot;, &quot;description&quot;: &quot;Strategies and methods to reduce bias in AI models.&quot;}, {&quot;name&quot;: &quot;Human Bias&quot;, &quot;description&quot;: &quot;The influence of human biases on AI decision-making.&quot;}]" />
