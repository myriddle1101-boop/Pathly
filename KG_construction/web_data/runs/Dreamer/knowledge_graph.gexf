          <attvalue for="5" value="Basic understanding of neural networks and calculus." />
          <attvalue for="6" value="[&quot;Sigmoid Function&quot;, &quot;ReLU (Rectified Linear Unit)&quot;, &quot;Tanh Function&quot;, &quot;Softmax Function&quot;]" />
          <attvalue for="7" value="[&quot;Activation functions are only used in the output layer.&quot;, &quot;All activation functions are equivalent.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Game AI&quot;, &quot;Financial forecasting&quot;]" />
        </attvalues>
      </node>
      <node id="Loss Functions" label="Loss Functions">
        <attvalues>
          <attvalue for="0" value="Functions used to measure the difference between predicted and actual outcomes." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Common Loss Functions&quot;, &quot;description&quot;: &quot;Overview of frequently used loss functions in machine learning.&quot;}, {&quot;name&quot;: &quot;Custom Loss Functions&quot;, &quot;description&quot;: &quot;Designing loss functions tailored to specific applications.&quot;}]" />
