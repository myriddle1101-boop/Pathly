          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and linear algebra." />
          <attvalue for="6" value="[&quot;Mean Squared Error (MSE)&quot;, &quot;Cross-Entropy Loss&quot;]" />
          <attvalue for="7" value="[&quot;Loss functions only apply to regression problems.&quot;, &quot;Lower loss always means better model performance.&quot;]" />
          <attvalue for="8" value="[&quot;Training machine learning models&quot;, &quot;Evaluating model performance&quot;]" />
        </attvalues>
      </node>
