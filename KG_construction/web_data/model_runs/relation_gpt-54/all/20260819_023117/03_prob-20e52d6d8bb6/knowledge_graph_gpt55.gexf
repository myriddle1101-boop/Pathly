    <nodes>
      <node id="Probability Theory" label="Probability Theory">
        <attvalues>
          <attvalue for="0" value="The mathematical framework for quantifying uncertainty." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Probability&quot;, &quot;description&quot;: &quot;The measure of the likelihood of an event.&quot;}, {&quot;name&quot;: &quot;Conditional Probability&quot;, &quot;description&quot;: &quot;The probability of an event given that another event has occurred.&quot;}, {&quot;name&quot;: &quot;Marginal Probability&quot;, &quot;description&quot;: &quot;The probability of an event irrespective of other events.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of algebra and calculus." />
          <attvalue for="6" value="[&quot;Random Variables&quot;, &quot;Probability Distributions&quot;, &quot;Bayes' Theorem&quot;, &quot;Law of Large Numbers&quot;]" />
          <attvalue for="7" value="[&quot;Probability is the same as chance&quot;, &quot;Independent events cannot affect each other&quot;]" />
          <attvalue for="8" value="[&quot;Statistical inference&quot;, &quot;Machine learning algorithms&quot;, &quot;Risk assessment&quot;, &quot;Game theory&quot;]" />
        </attvalues>
      </node>
      <node id="Probability Distributions" label="Probability Distributions">
        <attvalues>
          <attvalue for="0" value="Functions that describe the likelihood of different outcomes in a random variable." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Probability Density Function&quot;, &quot;description&quot;: &quot;A function that describes the relative likelihood for a continuous random variable.&quot;}, {&quot;name&quot;: &quot;Probability Mass Function&quot;, &quot;description&quot;: &quot;A function that gives the probability of discrete outcomes.&quot;}, {&quot;name&quot;: &quot;Normal Distribution&quot;, &quot;description&quot;: &quot;A continuous probability distribution characterized by a bell-shaped curve.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and algebra." />
          <attvalue for="6" value="[&quot;Discrete Probability Distributions&quot;, &quot;Continuous Probability Distributions&quot;]" />
          <attvalue for="7" value="[&quot;All distributions are normal&quot;, &quot;Probability distributions only apply to large datasets&quot;]" />
          <attvalue for="8" value="[&quot;Risk assessment in finance&quot;, &quot;Machine learning model evaluation&quot;]" />
        </attvalues>
      </node>
      <node id="Information Theory" label="Information Theory">
        <attvalues>
          <attvalue for="0" value="The study of quantification, storage, and communication of information." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Entropy&quot;, &quot;description&quot;: &quot;A measure of uncertainty or randomness in a probability distribution.&quot;}, {&quot;name&quot;: &quot;KL Divergence&quot;, &quot;description&quot;: &quot;A measure of how one probability distribution diverges from a second expected probability distribution.&quot;}, {&quot;name&quot;: &quot;Shannon Entropy&quot;, &quot;description&quot;: &quot;A specific measure of entropy used in information theory.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of probability and statistics." />
          <attvalue for="6" value="[&quot;Entropy&quot;, &quot;Mutual Information&quot;]" />
          <attvalue for="7" value="[&quot;Information is the same as data&quot;, &quot;Higher entropy means more useful information&quot;]" />
          <attvalue for="8" value="[&quot;Data compression&quot;, &quot;Error correction in communication systems&quot;]" />
        </attvalues>
      </node>
      <node id="Covariance" label="Covariance">
        <attvalues>
          <attvalue for="0" value="A measure of how much two random variables change together." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Covariance Matrix&quot;, &quot;description&quot;: &quot;A matrix that contains the covariances between pairs of variables.&quot;}, {&quot;name&quot;: &quot;Covariance Example&quot;, &quot;description&quot;: &quot;Illustrative examples demonstrating the concept of covariance.&quot;}, {&quot;name&quot;: &quot;Covariance Dependent&quot;, &quot;description&quot;: &quot;Situations where covariance is influenced by other variables.&quot;}]" />
          <attvalue for="2" value="2" />
