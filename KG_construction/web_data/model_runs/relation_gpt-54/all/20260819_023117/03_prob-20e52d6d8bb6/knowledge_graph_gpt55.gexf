          <attvalue for="6" value="[&quot;Variance&quot;, &quot;Correlation&quot;]" />
          <attvalue for="7" value="[&quot;Covariance indicates the strength of a relationship&quot;, &quot;Covariance is always a positive value&quot;]" />
          <attvalue for="8" value="[&quot;Portfolio optimization in finance&quot;, &quot;Feature selection in machine learning&quot;]" />
        </attvalues>
      </node>
      <node id="Random Variables" label="Random Variables">
        <attvalues>
