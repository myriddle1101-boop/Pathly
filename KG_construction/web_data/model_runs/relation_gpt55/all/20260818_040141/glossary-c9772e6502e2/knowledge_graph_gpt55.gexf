          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning and data structures." />
          <attvalue for="6" value="[&quot;Vector embeddings&quot;, &quot;Similarity search&quot;, &quot;Indexing techniques&quot;]" />
          <attvalue for="7" value="[&quot;Vector databases are the same as traditional databases&quot;, &quot;Only numerical data can be stored in vector databases&quot;]" />
          <attvalue for="8" value="[&quot;Recommendation systems&quot;, &quot;Image and text search&quot;, &quot;Natural language processing tasks&quot;]" />
