    <nodes>
      <node id="Autoencoders" label="Autoencoders">
        <attvalues>
          <attvalue for="0" value="A type of artificial neural network used for unsupervised learning tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Denoising Autoencoders&quot;, &quot;description&quot;: &quot;Autoencoders designed to remove noise from input data.&quot;}, {&quot;name&quot;: &quot;Contractive Autoencoders&quot;, &quot;description&quot;: &quot;Autoencoders that enforce a contractive penalty on the learned representation.&quot;}, {&quot;name&quot;: &quot;Sparse Autoencoders&quot;, &quot;description&quot;: &quot;Autoencoders that impose sparsity constraints on the hidden layer.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of neural networks and linear algebra." />
          <attvalue for="6" value="[&quot;Encoder&quot;, &quot;Decoder&quot;, &quot;Latent Space&quot;, &quot;Reconstruction Loss&quot;]" />
          <attvalue for="7" value="[&quot;Autoencoders are only for image data.&quot;, &quot;They can only be used for dimensionality reduction.&quot;]" />
          <attvalue for="8" value="[&quot;Image denoising&quot;, &quot;Anomaly detection&quot;, &quot;Data compression&quot;, &quot;Feature learning&quot;]" />
        </attvalues>
      </node>
      <node id="Manifold Learning" label="Manifold Learning">
        <attvalues>
          <attvalue for="0" value="A set of techniques for learning low-dimensional representations of high-dimensional data." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Tangent Hyperplane&quot;, &quot;description&quot;: &quot;A linear approximation of a manifold at a given point.&quot;}, {&quot;name&quot;: &quot;Manifold Representation&quot;, &quot;description&quot;: &quot;The representation of data points in a lower-dimensional manifold.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and statistics." />
          <attvalue for="6" value="[&quot;Dimensionality Reduction&quot;, &quot;Nonlinear Manifolds&quot;]" />
          <attvalue for="7" value="[&quot;Manifold learning is only for image data.&quot;, &quot;It always requires labeled data.&quot;]" />
          <attvalue for="8" value="[&quot;Data visualization&quot;, &quot;Preprocessing for machine learning models&quot;]" />
        </attvalues>
      </node>
      <node id="Learning Algorithms" label="Learning Algorithms">
        <attvalues>
          <attvalue for="0" value="Methods and techniques used to train models in machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Stochastic Autoencoders&quot;, &quot;description&quot;: &quot;Autoencoders that incorporate stochastic elements in their architecture.&quot;}, {&quot;name&quot;: &quot;Score Matching&quot;, &quot;description&quot;: &quot;A technique for estimating the parameters of probabilistic models.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and programming." />
          <attvalue for="6" value="[&quot;Supervised Learning&quot;, &quot;Unsupervised Learning&quot;, &quot;Reinforcement Learning&quot;, &quot;Model Evaluation&quot;]" />
          <attvalue for="7" value="[&quot;All algorithms work equally well for every problem.&quot;, &quot;More data always leads to better models.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Recommendation systems&quot;, &quot;Fraud detection&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Network Components" label="Neural Network Components">
        <attvalues>
          <attvalue for="0" value="Key elements that make up neural networks and their functionality." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Decoder&quot;, &quot;description&quot;: &quot;The part of an autoencoder that reconstructs the input from the encoded representation.&quot;}, {&quot;name&quot;: &quot;Activation Function&quot;, &quot;description&quot;: &quot;Functions that determine the output of a neuron given an input.&quot;}]" />
