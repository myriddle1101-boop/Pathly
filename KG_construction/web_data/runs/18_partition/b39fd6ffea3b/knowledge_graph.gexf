    <nodes>
      <node id="Likelihood Models" label="Likelihood Models">
        <attvalues>
          <attvalue for="0" value="Concepts related to likelihood in statistical modeling." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Maximum Likelihood&quot;, &quot;description&quot;: &quot;A method for estimating the parameters of a statistical model.&quot;}, {&quot;name&quot;: &quot;Log Likelihood&quot;, &quot;description&quot;: &quot;The logarithm of the likelihood function, often used for optimization.&quot;}, {&quot;name&quot;: &quot;Likelihood Gradient&quot;, &quot;description&quot;: &quot;The gradient of the likelihood function, used in optimization algorithms.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of probability and statistics, familiarity with random variables and distributions." />
          <attvalue for="6" value="[&quot;Maximum Likelihood Estimation (MLE)&quot;, &quot;Likelihood Ratio Tests&quot;]" />
          <attvalue for="7" value="[&quot;Likelihood is the same as probability&quot;, &quot;Higher likelihood always indicates a better model&quot;]" />
          <attvalue for="8" value="[&quot;Parameter estimation in statistical models&quot;, &quot;Hypothesis testing in various fields such as biology and economics&quot;]" />
        </attvalues>
      </node>
      <node id="Probabilistic Models" label="Probabilistic Models">
        <attvalues>
          <attvalue for="0" value="Models that incorporate randomness and uncertainty in predictions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Undirected Models&quot;, &quot;description&quot;: &quot;Models that do not have a directed relationship between variables.&quot;}, {&quot;name&quot;: &quot;Energy Function&quot;, &quot;description&quot;: &quot;A function that represents the energy of a system in probabilistic models.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and probability theory." />
          <attvalue for="6" value="[&quot;Bayesian Inference&quot;, &quot;Markov Models&quot;]" />
          <attvalue for="7" value="[&quot;Probabilistic models are only for complex problems&quot;, &quot;They always require large datasets&quot;]" />
          <attvalue for="8" value="[&quot;Natural Language Processing&quot;, &quot;Financial Forecasting&quot;]" />
        </attvalues>
      </node>
      <node id="Training Algorithms" label="Training Algorithms">
        <attvalues>
          <attvalue for="0" value="Algorithms used to train machine learning models." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Learning Algorithm&quot;, &quot;description&quot;: &quot;A method for adjusting model parameters based on data.&quot;}, {&quot;name&quot;: &quot;MCMC Algorithm&quot;, &quot;description&quot;: &quot;Markov Chain Monte Carlo, a method for sampling from probability distributions.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and statistics." />
          <attvalue for="6" value="[&quot;Gradient Descent&quot;, &quot;Stochastic Gradient Descent&quot;, &quot;Batch Learning&quot;, &quot;Online Learning&quot;]" />
          <attvalue for="7" value="[&quot;All algorithms converge to the same solution&quot;, &quot;More data always leads to better models&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Natural language processing&quot;, &quot;Recommendation systems&quot;, &quot;Predictive analytics&quot;]" />
        </attvalues>
      </node>
