          <attvalue for="7" value="[&quot;Design engineering is only about aesthetics.&quot;, &quot;Engineering design does not require creativity.&quot;]" />
          <attvalue for="8" value="[&quot;Creating consumer products&quot;, &quot;Developing software systems&quot;, &quot;Engineering solutions for manufacturing&quot;, &quot;Designing infrastructure projects&quot;]" />
        </attvalues>
      </node>
