    <nodes>
      <node id="Distributed Representation" label="Distributed Representation">
        <attvalues>
          <attvalue for="0" value="Techniques for representing data in a distributed manner across multiple dimensions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Binary Distributed&quot;, &quot;description&quot;: &quot;A specific type of distributed representation using binary values.&quot;}, {&quot;name&quot;: &quot;Representation Learning&quot;, &quot;description&quot;: &quot;Learning representations of data that capture its underlying structure.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and statistics." />
          <attvalue for="6" value="[&quot;Word Embeddings&quot;, &quot;Autoencoders&quot;]" />
          <attvalue for="7" value="[&quot;Distributed representation is only for text data.&quot;, &quot;It requires complex neural networks.&quot;]" />
          <attvalue for="8" value="[&quot;Natural Language Processing&quot;, &quot;Image Recognition&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Computational models inspired by the human brain, used for various machine learning tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Deep Networks&quot;, &quot;description&quot;: &quot;Neural networks with multiple layers that can learn complex patterns.&quot;}, {&quot;name&quot;: &quot;Multilayer Perceptrons&quot;, &quot;description&quot;: &quot;A type of neural network consisting of multiple layers of neurons.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Classification Techniques" label="Classification Techniques">
        <attvalues>
          <attvalue for="0" value="Methods used to categorize data into predefined classes." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Linear Classifier&quot;, &quot;description&quot;: &quot;A classifier that makes predictions based on a linear predictor function.&quot;}, {&quot;name&quot;: &quot;Causal Mechanisms&quot;, &quot;description&quot;: &quot;Understanding the cause-effect relationships in classification tasks.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and programming." />
          <attvalue for="6" value="[&quot;Binary Classification&quot;, &quot;Multi-class Classification&quot;, &quot;Evaluation Metrics&quot;, &quot;Overfitting and Underfitting&quot;]" />
          <attvalue for="7" value="[&quot;Classification is only for binary outcomes&quot;, &quot;More features always improve model performance&quot;]" />
          <attvalue for="8" value="[&quot;Email spam detection&quot;, &quot;Image recognition&quot;, &quot;Sentiment analysis&quot;, &quot;Medical diagnosis&quot;]" />
        </attvalues>
      </node>
      <node id="Training Methods" label="Training Methods">
        <attvalues>
          <attvalue for="0" value="Approaches for training machine learning models to improve their performance." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Pretraining&quot;, &quot;description&quot;: &quot;Initial training phase to learn general features before fine-tuning.&quot;}, {&quot;name&quot;: &quot;Denoising Pretraining&quot;, &quot;description&quot;: &quot;A technique to improve model robustness by training on corrupted data.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and algorithms." />
          <attvalue for="6" value="[&quot;Supervised Learning&quot;, &quot;Unsupervised Learning&quot;, &quot;Reinforcement Learning&quot;, &quot;Transfer Learning&quot;]" />
          <attvalue for="7" value="[&quot;All models require the same amount of training data&quot;, &quot;More complex models always perform better&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Natural language processing&quot;, &quot;Recommendation systems&quot;, &quot;Game AI&quot;]" />
        </attvalues>
      </node>
      <node id="Generative Models" label="Generative Models">
        <attvalues>
          <attvalue for="0" value="Models that can generate new data points from learned distributions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Generative Adversarial Networks&quot;, &quot;description&quot;: &quot;A framework where two networks compete to improve data generation.&quot;}, {&quot;name&quot;: &quot;Mixture Models&quot;, &quot;description&quot;: &quot;Statistical models that represent data as a mixture of multiple distributions.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of probability, statistics, and machine learning fundamentals." />
          <attvalue for="6" value="[&quot;Variational Autoencoders&quot;, &quot;Generative Adversarial Networks&quot;]" />
          <attvalue for="7" value="[&quot;Generative models only work with images&quot;, &quot;They cannot produce high-quality data&quot;]" />
          <attvalue for="8" value="[&quot;Image synthesis&quot;, &quot;Text generation&quot;]" />
        </attvalues>
      </node>
      <node id="Transfer Learning" label="Transfer Learning">
        <attvalues>
          <attvalue for="0" value="A technique where knowledge gained from one task is applied to a different but related task." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Multitask Learning&quot;, &quot;description&quot;: &quot;Simultaneously training on multiple tasks to improve generalization.&quot;}, {&quot;name&quot;: &quot;Domain Adaptation&quot;, &quot;description&quot;: &quot;Adapting a model trained on one domain to work in another domain.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and neural networks." />
          <attvalue for="6" value="[&quot;Fine-tuning&quot;, &quot;Feature extraction&quot;]" />
          <attvalue for="7" value="[&quot;Transfer learning only works for similar tasks&quot;, &quot;Pre-trained models are always better than training from scratch&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Error Analysis" label="Error Analysis">
        <attvalues>
          <attvalue for="0" value="Techniques for analyzing and understanding errors in model predictions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Concept Drift&quot;, &quot;description&quot;: &quot;The change in the statistical properties of the target variable over time.&quot;}, {&quot;name&quot;: &quot;Training Sets&quot;, &quot;description&quot;: &quot;The datasets used to train machine learning models.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and model evaluation metrics." />
          <attvalue for="6" value="[&quot;Types of errors (false positives, false negatives)&quot;, &quot;Confusion matrix&quot;, &quot;Error distribution analysis&quot;, &quot;Bias-variance tradeoff&quot;]" />
          <attvalue for="7" value="[&quot;All errors are equally important&quot;, &quot;Error analysis is only for classification problems&quot;, &quot;Improving accuracy always means reducing errors&quot;]" />
          <attvalue for="8" value="[&quot;Improving model performance&quot;, &quot;Identifying data quality issues&quot;, &quot;Guiding feature engineering&quot;, &quot;Enhancing model interpretability&quot;]" />
        </attvalues>
      </node>
      <node id="Activation Functions" label="Activation Functions">
        <attvalues>
          <attvalue for="0" value="Functions that determine the output of a neuron in a neural network." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Linear Activation&quot;, &quot;description&quot;: &quot;An activation function that outputs the input directly.&quot;}, {&quot;name&quot;: &quot;Non-linear Activation&quot;, &quot;description&quot;: &quot;Activation functions that introduce non-linearity into the model.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of neural networks and calculus." />
          <attvalue for="6" value="[&quot;Sigmoid Function&quot;, &quot;ReLU (Rectified Linear Unit)&quot;, &quot;Tanh Function&quot;, &quot;Softmax Function&quot;]" />
          <attvalue for="7" value="[&quot;Activation functions are only used in the output layer.&quot;, &quot;All activation functions are equally effective.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Game AI&quot;, &quot;Financial forecasting&quot;]" />
        </attvalues>
      </node>
      <node id="Backpropagation" label="Backpropagation">
        <attvalues>
          <attvalue for="0" value="An algorithm for training neural networks by minimizing the loss function." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Loss Function&quot;, &quot;description&quot;: &quot;A function that measures the difference between predicted and actual values.&quot;}, {&quot;name&quot;: &quot;Gradient Descent&quot;, &quot;description&quot;: &quot;An optimization algorithm used to minimize the loss function.&quot;}]" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus, linear algebra, and neural networks." />
          <attvalue for="6" value="[&quot;Gradient Descent&quot;, &quot;Chain Rule&quot;, &quot;Loss Function&quot;]" />
          <attvalue for="7" value="[&quot;Backpropagation is the same as training a neural network.&quot;, &quot;It only works for feedforward networks.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
    </nodes>
