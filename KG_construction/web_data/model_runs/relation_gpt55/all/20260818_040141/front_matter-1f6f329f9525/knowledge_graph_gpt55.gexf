    <nodes>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="A class of models inspired by the human brain, used for various machine learning tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Neural Network Types&quot;, &quot;description&quot;: &quot;Different architectures of neural networks, including feedforward and recurrent.&quot;}, {&quot;name&quot;: &quot;Activation Functions&quot;, &quot;description&quot;: &quot;Functions that determine the output of a neural network node.&quot;}, {&quot;name&quot;: &quot;Loss Functions&quot;, &quot;description&quot;: &quot;Metrics used to evaluate the performance of a neural network during training.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Deep Learning" label="Deep Learning">
        <attvalues>
          <attvalue for="0" value="A subset of machine learning focused on neural networks with many layers." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Convolutional Neural Networks&quot;, &quot;description&quot;: &quot;Neural networks designed for processing structured grid data like images.&quot;}, {&quot;name&quot;: &quot;Recurrent Neural Networks&quot;, &quot;description&quot;: &quot;Neural networks that are particularly suited for sequential data.&quot;}, {&quot;name&quot;: &quot;Autoencoders&quot;, &quot;description&quot;: &quot;Neural networks used for unsupervised learning of efficient codings.&quot;}]" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, calculus, and programming in Python." />
          <attvalue for="6" value="[&quot;Neural Networks&quot;, &quot;Backpropagation&quot;, &quot;Convolutional Neural Networks (CNNs)&quot;, &quot;Recurrent Neural Networks (RNNs)&quot;]" />
          <attvalue for="7" value="[&quot;Deep learning is the same as machine learning.&quot;, &quot;More layers always lead to better performance.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Autonomous vehicles&quot;, &quot;Healthcare diagnostics&quot;]" />
        </attvalues>
      </node>
      <node id="Training Techniques" label="Training Techniques">
        <attvalues>
          <attvalue for="0" value="Methods and strategies for training machine learning models effectively." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Backpropagation&quot;, &quot;description&quot;: &quot;An algorithm for training neural networks by minimizing the loss function.&quot;}, {&quot;name&quot;: &quot;Stochastic Gradient Descent&quot;, &quot;description&quot;: &quot;An optimization algorithm used to minimize the loss function.&quot;}, {&quot;name&quot;: &quot;Contrastive Divergence&quot;, &quot;description&quot;: &quot;A method for training models like Restricted Boltzmann Machines.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and algorithms." />
          <attvalue for="6" value="[&quot;Supervised Learning&quot;, &quot;Unsupervised Learning&quot;, &quot;Overfitting and Underfitting&quot;, &quot;Cross-Validation&quot;, &quot;Hyperparameter Tuning&quot;]" />
          <attvalue for="7" value="[&quot;More data always leads to better models&quot;, &quot;Training and testing data can be mixed&quot;, &quot;Complex models are always better&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Natural language processing&quot;, &quot;Predictive analytics&quot;, &quot;Recommendation systems&quot;]" />
        </attvalues>
      </node>
      <node id="Learning Representations" label="Learning Representations">
        <attvalues>
          <attvalue for="0" value="Techniques for transforming input data into a format suitable for machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Feature Learning&quot;, &quot;description&quot;: &quot;Automatically discovering the representations needed for feature detection.&quot;}, {&quot;name&quot;: &quot;Dimensionality Reduction&quot;, &quot;description&quot;: &quot;Techniques for reducing the number of features in a dataset.&quot;}, {&quot;name&quot;: &quot;Generative Models&quot;, &quot;description&quot;: &quot;Models that can generate new data points from learned distributions.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and statistics." />
          <attvalue for="6" value="[&quot;Feature Extraction&quot;, &quot;Dimensionality Reduction&quot;]" />
          <attvalue for="7" value="[&quot;Learning representations is only about neural networks.&quot;, &quot;More features always lead to better performance.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Statistical Learning" label="Statistical Learning">
        <attvalues>
          <attvalue for="0" value="A framework for understanding and applying statistical methods in machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Gaussian Processes&quot;, &quot;description&quot;: &quot;A probabilistic model used for regression and classification tasks.&quot;}, {&quot;name&quot;: &quot;Learning Theory&quot;, &quot;description&quot;: &quot;The study of the principles and algorithms of machine learning.&quot;}, {&quot;name&quot;: &quot;Statistical Language Models&quot;, &quot;description&quot;: &quot;Models that predict the probability of sequences of words.&quot;}]" />
          <attvalue for="2" value="2" />
