          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus." />
          <attvalue for="6" value="[&quot;Nodes and edges&quot;, &quot;Forward and backward propagation&quot;]" />
          <attvalue for="7" value="[&quot;Computational graphs are only for deep learning&quot;, &quot;Graphs are only for visual representation&quot;]" />
          <attvalue for="8" value="[&quot;Optimizing neural network training&quot;, &quot;Visualizing complex computations&quot;]" />
        </attvalues>
      </node>
      <node id="Training Techniques" label="Training Techniques">
        <attvalues>
          <attvalue for="0" value="Methods and strategies for effectively training machine learning models." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Minibatch Gradient Descent&quot;, &quot;description&quot;: &quot;A variant of gradient descent that uses small batches of data.&quot;}, {&quot;name&quot;: &quot;Model Training&quot;, &quot;description&quot;: &quot;The process of optimizing a model's parameters.&quot;}]" />
