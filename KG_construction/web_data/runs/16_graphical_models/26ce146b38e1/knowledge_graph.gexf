    <nodes>
      <node id="Deep Learning" label="Deep Learning">
        <attvalues>
          <attvalue for="0" value="A subset of machine learning focused on neural networks with many layers." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Artificial Neural Networks&quot;, &quot;description&quot;: &quot;Computational models inspired by the human brain's network of neurons.&quot;}, {&quot;name&quot;: &quot;Activation Functions&quot;, &quot;description&quot;: &quot;Functions that determine the output of a neural network node.&quot;}, {&quot;name&quot;: &quot;Loss Functions&quot;, &quot;description&quot;: &quot;Metrics used to measure the difference between predicted and actual outcomes.&quot;}]" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, calculus, and programming in Python." />
          <attvalue for="6" value="[&quot;Neural Networks&quot;, &quot;Backpropagation&quot;, &quot;Convolutional Neural Networks (CNNs)&quot;, &quot;Recurrent Neural Networks (RNNs)&quot;]" />
          <attvalue for="7" value="[&quot;Deep learning is the same as machine learning.&quot;, &quot;More layers always lead to better performance.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Speech recognition&quot;, &quot;Game playing (e.g., AlphaGo)&quot;]" />
        </attvalues>
      </node>
      <node id="Probabilistic Models" label="Probabilistic Models">
        <attvalues>
          <attvalue for="0" value="Models that incorporate uncertainty and randomness in predictions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Probability Distributions&quot;, &quot;description&quot;: &quot;Functions that describe the likelihood of different outcomes.&quot;}, {&quot;name&quot;: &quot;Conditional Distributions&quot;, &quot;description&quot;: &quot;Distributions that specify the probability of an event given another event.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and probability theory." />
          <attvalue for="6" value="[&quot;Bayesian Inference&quot;, &quot;Markov Models&quot;]" />
          <attvalue for="7" value="[&quot;Probabilistic models are only for complex problems&quot;, &quot;They always require large datasets&quot;]" />
          <attvalue for="8" value="[&quot;Natural Language Processing&quot;, &quot;Medical Diagnosis&quot;]" />
        </attvalues>
      </node>
      <node id="Graph Models" label="Graph Models">
        <attvalues>
          <attvalue for="0" value="Models that represent relationships and dependencies using graph structures." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Factor Graphs&quot;, &quot;description&quot;: &quot;Graphs that represent the factorization of a probability distribution.&quot;}, {&quot;name&quot;: &quot;Undirected Graphs&quot;, &quot;description&quot;: &quot;Graphs where edges have no direction, representing symmetric relationships.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of graph theory and introductory machine learning concepts." />
          <attvalue for="6" value="[&quot;Graph representation&quot;, &quot;Graph traversal algorithms&quot;, &quot;Node and edge features&quot;, &quot;Graph neural networks&quot;]" />
          <attvalue for="7" value="[&quot;Graphs can only represent static relationships&quot;, &quot;Graph models are only for social networks&quot;]" />
          <attvalue for="8" value="[&quot;Social network analysis&quot;, &quot;Recommendation systems&quot;, &quot;Biological network modeling&quot;, &quot;Fraud detection&quot;]" />
        </attvalues>
      </node>
      <node id="Structured Modeling" label="Structured Modeling">
        <attvalues>
          <attvalue for="0" value="Modeling techniques that leverage the structure of data for better predictions." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Structured Probabilistic Models&quot;, &quot;description&quot;: &quot;Models that combine structured data with probabilistic reasoning.&quot;}, {&quot;name&quot;: &quot;Model Structure&quot;, &quot;description&quot;: &quot;The arrangement and relationships of variables in a model.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and introductory machine learning concepts." />
          <attvalue for="6" value="[&quot;Graphical Models&quot;, &quot;Hierarchical Models&quot;]" />
          <attvalue for="7" value="[&quot;Structured modeling is only for complex data&quot;, &quot;It requires advanced programming skills&quot;]" />
          <attvalue for="8" value="[&quot;Natural Language Processing&quot;, &quot;Recommendation Systems&quot;]" />
        </attvalues>
      </node>
      <node id="Graph Theory" label="Graph Theory">
        <attvalues>
          <attvalue for="0" value="The study of graphs and their properties, crucial for understanding complex networks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Directed Graphs&quot;, &quot;description&quot;: &quot;Graphs where edges have a direction, indicating a one-way relationship.&quot;}, {&quot;name&quot;: &quot;Complete Graphs&quot;, &quot;description&quot;: &quot;Graphs in which every pair of vertices is connected by an edge.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of discrete mathematics and familiarity with sets and functions." />
          <attvalue for="6" value="[&quot;Vertices and edges&quot;, &quot;Graph types (directed, undirected, weighted, unweighted)&quot;, &quot;Graph traversal algorithms (BFS, DFS)&quot;, &quot;Graph connectivity&quot;, &quot;Graph representations (adjacency list, adjacency matrix)&quot;]" />
          <attvalue for="7" value="[&quot;All graphs are trees&quot;, &quot;Graphs can only represent linear relationships&quot;, &quot;Graph theory is only applicable in computer science&quot;]" />
          <attvalue for="8" value="[&quot;Social network analysis&quot;, &quot;Routing algorithms in networks&quot;, &quot;Recommendation systems&quot;, &quot;Biological network modeling&quot;, &quot;Urban planning and transportation networks&quot;]" />
        </attvalues>
      </node>
      <node id="Sampling Techniques" label="Sampling Techniques">
        <attvalues>
          <attvalue for="0" value="Methods for selecting a subset of data from a larger dataset for analysis." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Example Sampling&quot;, &quot;description&quot;: &quot;Selecting representative examples from a dataset.&quot;}, {&quot;name&quot;: &quot;Sampling Tasks&quot;, &quot;description&quot;: &quot;Specific objectives or goals related to data sampling.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and data analysis." />
          <attvalue for="6" value="[&quot;Random Sampling&quot;, &quot;Stratified Sampling&quot;, &quot;Systematic Sampling&quot;, &quot;Cluster Sampling&quot;]" />
          <attvalue for="7" value="[&quot;Sampling is always random&quot;, &quot;Larger samples are always better&quot;]" />
          <attvalue for="8" value="[&quot;Survey research&quot;, &quot;A/B testing&quot;, &quot;Market research&quot;, &quot;Quality control&quot;]" />
        </attvalues>
      </node>
      <node id="Training Algorithms" label="Training Algorithms">
        <attvalues>
          <attvalue for="0" value="Algorithms used to optimize models based on training data." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Backpropagation&quot;, &quot;description&quot;: &quot;A method for updating weights in neural networks based on error gradients.&quot;}, {&quot;name&quot;: &quot;Linear Separation&quot;, &quot;description&quot;: &quot;The ability to separate classes in a dataset using a linear boundary.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and linear algebra." />
          <attvalue for="6" value="[&quot;Gradient Descent&quot;, &quot;Stochastic Gradient Descent&quot;, &quot;Batch Learning&quot;, &quot;Online Learning&quot;]" />
          <attvalue for="7" value="[&quot;All algorithms converge to the same solution&quot;, &quot;More data always leads to better models&quot;]" />
          <attvalue for="8" value="[&quot;Image classification&quot;, &quot;Natural language processing&quot;, &quot;Recommendation systems&quot;, &quot;Financial forecasting&quot;]" />
        </attvalues>
      </node>
      <node id="Model Evaluation" label="Model Evaluation">
        <attvalues>
          <attvalue for="0" value="Techniques for assessing the performance of machine learning models." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Regression Analysis&quot;, &quot;description&quot;: &quot;A statistical method for predicting continuous outcomes.&quot;}, {&quot;name&quot;: &quot;Classification Metrics&quot;, &quot;description&quot;: &quot;Metrics used to evaluate the accuracy of classification models.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and statistics." />
          <attvalue for="6" value="[&quot;Confusion Matrix&quot;, &quot;ROC Curve&quot;, &quot;Precision and Recall&quot;, &quot;F1 Score&quot;, &quot;Cross-Validation&quot;]" />
          <attvalue for="7" value="[&quot;Accuracy is the only metric that matters.&quot;, &quot;Overfitting is not a concern if the model performs well on training data.&quot;]" />
          <attvalue for="8" value="[&quot;Evaluating classification models in healthcare.&quot;, &quot;Assessing predictive models in finance.&quot;]" />
        </attvalues>
      </node>
      <node id="Graph Representations" label="Graph Representations">
        <attvalues>
          <attvalue for="0" value="Different ways to represent data and relationships using graphs." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Graph Probability&quot;, &quot;description&quot;: &quot;The use of graphs to represent probabilistic relationships.&quot;}, {&quot;name&quot;: &quot;Graph Ambiguity&quot;, &quot;description&quot;: &quot;Challenges in interpreting graphs due to multiple possible interpretations.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of data structures and algorithms." />
          <attvalue for="6" value="[&quot;Adjacency Matrix&quot;, &quot;Adjacency List&quot;, &quot;Edge List&quot;, &quot;Graph Traversal&quot;]" />
          <attvalue for="7" value="[&quot;Graphs can only represent linear relationships.&quot;, &quot;All graphs are undirected.&quot;]" />
          <attvalue for="8" value="[&quot;Social network analysis&quot;, &quot;Recommendation systems&quot;, &quot;Routing algorithms&quot;, &quot;Biological network modeling&quot;]" />
        </attvalues>
      </node>
    </nodes>
