          <attvalue for="1" value="[{&quot;name&quot;: &quot;Bayesian Inference&quot;, &quot;description&quot;: &quot;A method of statistical inference in which Bayes' theorem is used to update the probability of a hypothesis.&quot;}, {&quot;name&quot;: &quot;Random Variables&quot;, &quot;description&quot;: &quot;Variables whose values are determined by the outcomes of a random phenomenon.&quot;}]" />
