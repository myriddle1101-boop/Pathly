    <nodes>
      <node id="Recurrent Neural Networks" label="Recurrent Neural Networks">
        <attvalues>
          <attvalue for="0" value="A class of neural networks designed for sequence prediction tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Sequence Modeling&quot;, &quot;description&quot;: &quot;Techniques for modeling sequential data.&quot;}, {&quot;name&quot;: &quot;RNN Architecture&quot;, &quot;description&quot;: &quot;The structural design of recurrent neural networks.&quot;}, {&quot;name&quot;: &quot;Gradient Clipping&quot;, &quot;description&quot;: &quot;A technique to prevent exploding gradients during training.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of neural networks and linear algebra." />
          <attvalue for="6" value="[&quot;Long Short-Term Memory (LSTM)&quot;, &quot;Gated Recurrent Units (GRU)&quot;]" />
          <attvalue for="7" value="[&quot;RNNs can remember all past information indefinitely&quot;, &quot;RNNs are only suitable for text data&quot;]" />
          <attvalue for="8" value="[&quot;Natural language processing&quot;, &quot;Time series forecasting&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Computational models inspired by the human brain, used for various tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Activation Functions&quot;, &quot;description&quot;: &quot;Functions that determine the output of a neural network node.&quot;}, {&quot;name&quot;: &quot;Loss Functions&quot;, &quot;description&quot;: &quot;Metrics used to evaluate the performance of a model.&quot;}, {&quot;name&quot;: &quot;Backpropagation&quot;, &quot;description&quot;: &quot;An algorithm for training neural networks through gradient descent.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Computational Graphs" label="Computational Graphs">
        <attvalues>
          <attvalue for="0" value="Graphical representations of mathematical computations in neural networks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Graphical Models&quot;, &quot;description&quot;: &quot;Models that use graphs to represent dependencies among variables.&quot;}, {&quot;name&quot;: &quot;Unfolding Graphs&quot;, &quot;description&quot;: &quot;Techniques to visualize recurrent networks over time.&quot;}]" />
