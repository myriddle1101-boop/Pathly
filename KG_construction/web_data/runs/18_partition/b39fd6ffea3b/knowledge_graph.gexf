        <attvalues>
          <attvalue for="0" value="Techniques for generating samples from a model." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Positive Phase&quot;, &quot;description&quot;: &quot;The phase in sampling where positive samples are generated.&quot;}, {&quot;name&quot;: &quot;Negative Phase&quot;, &quot;description&quot;: &quot;The phase in sampling where negative samples are generated.&quot;}]" />
