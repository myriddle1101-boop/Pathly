      <node id="Network Architecture" label="Network Architecture">
        <attvalues>
          <attvalue for="0" value="The design and structure of neural networks, including their layers and connections." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Layer Types&quot;, &quot;description&quot;: &quot;Different types of layers used in neural networks, such as convolutional and fully connected.&quot;}, {&quot;name&quot;: &quot;Network Size&quot;, &quot;description&quot;: &quot;The number of layers and neurons in a neural network.&quot;}, {&quot;name&quot;: &quot;Strided Convolution&quot;, &quot;description&quot;: &quot;A convolution operation that skips certain input elements to reduce output size.&quot;}]" />
