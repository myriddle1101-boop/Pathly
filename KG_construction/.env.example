# Copy this file to either:
# - D:\ic\master project\project_code\.env
# - D:\ic\master project\project_code\KG_construction\.env
#
# Do not commit a real .env file with secrets.

# Keep JSON as the default backend until Neo4j is running and imported.
KG_BACKEND=json

# OpenAI is needed only for LLM-backed extraction/generation paths.
OPENAI_API_KEY=

# Neo4j Knowledge Graph backend.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
