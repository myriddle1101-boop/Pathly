    <nodes>
      <node id="Variance" label="Variance">
        <attvalues>
          <attvalue for="0" value="Key concept in statistics and machine learning that measures the spread of data points." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Variance Reduction&quot;, &quot;description&quot;: &quot;Techniques aimed at minimizing variance in model predictions.&quot;}, {&quot;name&quot;: &quot;Low Variance&quot;, &quot;description&quot;: &quot;Strategies to achieve low variance in model training.&quot;}, {&quot;name&quot;: &quot;Variance Estimation&quot;, &quot;description&quot;: &quot;Methods for estimating variance in datasets.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and data analysis." />
          <attvalue for="6" value="[&quot;Standard Deviation&quot;, &quot;Bias-Variance Tradeoff&quot;]" />
          <attvalue for="7" value="[&quot;Variance is the same as standard deviation&quot;, &quot;Higher variance always indicates a problem&quot;]" />
          <attvalue for="8" value="[&quot;Model evaluation in machine learning&quot;, &quot;Understanding data distribution&quot;]" />
        </attvalues>
      </node>
      <node id="Sampling Techniques" label="Sampling Techniques">
        <attvalues>
          <attvalue for="0" value="Methods used to select a subset of data for analysis in machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Importance Sampling&quot;, &quot;description&quot;: &quot;A technique that improves the efficiency of sampling.&quot;}, {&quot;name&quot;: &quot;Unbiased Sampling&quot;, &quot;description&quot;: &quot;Sampling methods that ensure unbiased representation of the population.&quot;}, {&quot;name&quot;: &quot;Subsampling&quot;, &quot;description&quot;: &quot;Selecting a smaller subset from a larger dataset.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and data analysis." />
          <attvalue for="6" value="[&quot;Random Sampling&quot;, &quot;Stratified Sampling&quot;, &quot;Systematic Sampling&quot;, &quot;Cluster Sampling&quot;]" />
          <attvalue for="7" value="[&quot;Sampling is only about random selection.&quot;, &quot;Larger samples always yield better results.&quot;]" />
          <attvalue for="8" value="[&quot;Survey data collection&quot;, &quot;Training machine learning models&quot;, &quot;A/B testing&quot;, &quot;Market research&quot;]" />
        </attvalues>
      </node>
