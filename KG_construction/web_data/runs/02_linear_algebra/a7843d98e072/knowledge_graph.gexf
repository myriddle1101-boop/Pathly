    <nodes>
      <node id="Linear Algebra" label="Linear Algebra">
        <attvalues>
          <attvalue for="0" value="The mathematical foundation for many machine learning algorithms." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Matrices&quot;, &quot;description&quot;: &quot;Rectangular arrays of numbers essential for data representation.&quot;}, {&quot;name&quot;: &quot;Matrix Operations&quot;, &quot;description&quot;: &quot;Fundamental operations including addition, multiplication, and inversion.&quot;}, {&quot;name&quot;: &quot;Eigenvalues and Eigenvectors&quot;, &quot;description&quot;: &quot;Key concepts for understanding transformations and dimensionality reduction.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of algebra and familiarity with mathematical notation." />
          <attvalue for="6" value="[&quot;Vectors&quot;, &quot;Matrices&quot;, &quot;Matrix Operations&quot;, &quot;Eigenvalues and Eigenvectors&quot;]" />
          <attvalue for="7" value="[&quot;Linear algebra is only about solving equations&quot;, &quot;Vectors can only represent physical quantities&quot;]" />
          <attvalue for="8" value="[&quot;Data representation in machine learning&quot;, &quot;Dimensionality reduction techniques like PCA&quot;]" />
        </attvalues>
      </node>
      <node id="Matrix Inversion" label="Matrix Inversion">
        <attvalues>
          <attvalue for="0" value="The process of finding the inverse of a matrix, crucial for solving linear equations." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Identity Matrix&quot;, &quot;description&quot;: &quot;A special matrix that acts as a multiplicative identity.&quot;}, {&quot;name&quot;: &quot;Matrix Inverses&quot;, &quot;description&quot;: &quot;Understanding the conditions under which a matrix can be inverted.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, including matrix operations and determinants." />
          <attvalue for="6" value="[&quot;Determinants&quot;, &quot;Adjugate Matrix&quot;, &quot;Gaussian Elimination&quot;]" />
          <attvalue for="7" value="[&quot;All matrices have inverses&quot;, &quot;Matrix inversion is always computationally efficient&quot;]" />
          <attvalue for="8" value="[&quot;Solving systems of linear equations&quot;, &quot;Computer graphics transformations&quot;]" />
        </attvalues>
      </node>
      <node id="Matrix Decomposition" label="Matrix Decomposition">
        <attvalues>
          <attvalue for="0" value="Techniques for breaking down matrices into simpler components." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Singular Value Decomposition (SVD)&quot;, &quot;description&quot;: &quot;A method for decomposing a matrix into its constituent parts.&quot;}, {&quot;name&quot;: &quot;Eigendecomposition&quot;, &quot;description&quot;: &quot;Decomposing a matrix into its eigenvalues and eigenvectors.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, including matrix operations and eigenvalues." />
          <attvalue for="6" value="[&quot;Singular Value Decomposition (SVD)&quot;, &quot;Principal Component Analysis (PCA)&quot;]" />
          <attvalue for="7" value="[&quot;Matrix decomposition is only for square matrices.&quot;, &quot;Decomposed matrices always have the same dimensions as the original.&quot;]" />
          <attvalue for="8" value="[&quot;Data compression&quot;, &quot;Image processing&quot;, &quot;Recommendation systems&quot;, &quot;Dimensionality reduction&quot;]" />
        </attvalues>
      </node>
