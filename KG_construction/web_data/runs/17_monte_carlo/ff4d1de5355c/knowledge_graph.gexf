          <attvalue for="7" value="[&quot;Empirical methods are always more accurate than theoretical methods.&quot;, &quot;Empirical data is free from bias.&quot;]" />
          <attvalue for="8" value="[&quot;Market Research&quot;, &quot;Clinical Trials&quot;]" />
        </attvalues>
      </node>
