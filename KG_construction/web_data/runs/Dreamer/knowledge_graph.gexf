    <nodes>
      <node id="Cartpole Dynamics" label="Cartpole Dynamics">
        <attvalues>
          <attvalue for="0" value="Explores the dynamics and control strategies for the cartpole problem." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Swingup Cartpole&quot;, &quot;description&quot;: &quot;Techniques for swinging the cartpole to an upright position.&quot;}, {&quot;name&quot;: &quot;Balance Cartpole&quot;, &quot;description&quot;: &quot;Methods for maintaining the cartpole in a balanced state.&quot;}, {&quot;name&quot;: &quot;Sparse Cartpole&quot;, &quot;description&quot;: &quot;Approaches using sparse representations for cartpole control.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of physics and introductory control theory." />
          <attvalue for="6" value="[&quot;Inverted Pendulum&quot;, &quot;State Space Representation&quot;, &quot;Control Strategies (PID, LQR)&quot;]" />
          <attvalue for="7" value="[&quot;The cartpole is stable when upright&quot;, &quot;Only linear control methods are effective&quot;]" />
          <attvalue for="8" value="[&quot;Robotics&quot;, &quot;Automated Balancing Systems&quot;, &quot;Game Development&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Computation" label="Neural Computation">
        <attvalues>
          <attvalue for="0" value="Focuses on the principles and applications of neural networks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Neural Information&quot;, &quot;description&quot;: &quot;Study of information processing in neural networks.&quot;}, {&quot;name&quot;: &quot;Neural Network Models&quot;, &quot;description&quot;: &quot;Different architectures and components of neural networks.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Imagination and Planning" label="Imagination and Planning">
        <attvalues>
          <attvalue for="0" value="Investigates the role of imagination in planning and decision-making." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Universal Planning Networks&quot;, &quot;description&quot;: &quot;Frameworks for planning using neural networks.&quot;}, {&quot;name&quot;: &quot;Imagination Horizon&quot;, &quot;description&quot;: &quot;Concepts related to the foresight in planning.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of cognitive psychology and decision-making processes." />
          <attvalue for="6" value="[&quot;Mental Simulation&quot;, &quot;Future Planning&quot;]" />
          <attvalue for="7" value="[&quot;Imagination is purely creative and not analytical.&quot;, &quot;Planning does not require emotional considerations.&quot;]" />
          <attvalue for="8" value="[&quot;Strategic decision-making in business&quot;, &quot;Creative problem-solving in engineering&quot;]" />
        </attvalues>
      </node>
      <node id="Reconstruction Techniques" label="Reconstruction Techniques">
        <attvalues>
          <attvalue for="0" value="Methods for reconstructing data and predictions in machine learning." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Image Reconstruction&quot;, &quot;description&quot;: &quot;Techniques for reconstructing images from data.&quot;}, {&quot;name&quot;: &quot;Long-term Predictions&quot;, &quot;description&quot;: &quot;Approaches for reconstructing long-term predictions.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning concepts and data structures." />
          <attvalue for="6" value="[&quot;Data Imputation&quot;, &quot;Autoencoders&quot;]" />
          <attvalue for="7" value="[&quot;Reconstruction is only for missing data&quot;, &quot;All reconstruction techniques are the same&quot;]" />
          <attvalue for="8" value="[&quot;Image denoising&quot;, &quot;Data compression&quot;]" />
        </attvalues>
      </node>
      <node id="Latent Dynamics Models" label="Latent Dynamics Models">
        <attvalues>
          <attvalue for="0" value="Models that capture the latent dynamics of systems." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;For Latent Dynamics Models&quot;, &quot;description&quot;: &quot;Techniques and frameworks for latent dynamics.&quot;}, {&quot;name&quot;: &quot;Dreamer Models&quot;, &quot;description&quot;: &quot;Specific models for dreaming and planning in latent spaces.&quot;}]" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning, linear algebra, and probability theory." />
          <attvalue for="6" value="[&quot;Latent Variables&quot;, &quot;Dynamic Systems&quot;, &quot;State Space Models&quot;, &quot;Variational Inference&quot;]" />
          <attvalue for="7" value="[&quot;Latent dynamics models are only for time series data.&quot;, &quot;They cannot be used for non-linear systems.&quot;]" />
          <attvalue for="8" value="[&quot;Robotics for motion planning&quot;, &quot;Economics for modeling market dynamics&quot;, &quot;Biology for population dynamics&quot;, &quot;Computer Vision for object tracking&quot;]" />
        </attvalues>
      </node>
      <node id="Hopper Dynamics" label="Hopper Dynamics">
        <attvalues>
          <attvalue for="0" value="Focuses on the dynamics and control strategies for the hopper problem." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Hopper Stand&quot;, &quot;description&quot;: &quot;Techniques for maintaining the hopper in a standing position.&quot;}, {&quot;name&quot;: &quot;Hopper Hop&quot;, &quot;description&quot;: &quot;Methods for controlling the hopping motion of the hopper.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of dynamics and control systems, familiarity with linear algebra and differential equations." />
          <attvalue for="6" value="[&quot;Hopper model dynamics&quot;, &quot;Control strategies for stability&quot;]" />
          <attvalue for="7" value="[&quot;Hopper dynamics only involves static analysis&quot;, &quot;Control strategies are universally applicable without modification&quot;]" />
          <attvalue for="8" value="[&quot;Robotics and automation&quot;, &quot;Simulation of bipedal locomotion&quot;]" />
        </attvalues>
      </node>
      <node id="Activation Functions" label="Activation Functions">
        <attvalues>
          <attvalue for="0" value="Functions that determine the output of neural network nodes." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Common Activation Functions&quot;, &quot;description&quot;: &quot;Overview of widely used activation functions in neural networks.&quot;}, {&quot;name&quot;: &quot;Custom Activation Functions&quot;, &quot;description&quot;: &quot;Development of specialized activation functions for specific tasks.&quot;}]" />
