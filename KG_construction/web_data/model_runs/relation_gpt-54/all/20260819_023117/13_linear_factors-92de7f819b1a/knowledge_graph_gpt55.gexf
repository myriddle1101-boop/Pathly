          <attvalue for="7" value="[&quot;All algorithms are the same&quot;, &quot;More data always leads to better models&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Spam detection&quot;, &quot;Recommendation systems&quot;]" />
        </attvalues>
