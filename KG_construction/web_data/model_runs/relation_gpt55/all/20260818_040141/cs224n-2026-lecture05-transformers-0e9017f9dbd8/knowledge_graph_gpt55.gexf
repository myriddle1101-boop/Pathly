          <attvalue for="1" value="[{&quot;name&quot;: &quot;RNN Language Models&quot;, &quot;description&quot;: &quot;Recurrent neural networks used for language processing.&quot;}, {&quot;name&quot;: &quot;Neural Representation&quot;, &quot;description&quot;: &quot;The way language is represented in neural networks.&quot;}]" />
