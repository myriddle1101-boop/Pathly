    <nodes>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Fundamental structures that mimic the way human brains operate to process data." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Artificial Neural Network&quot;, &quot;description&quot;: &quot;A computational model based on the structure and functions of biological neural networks.&quot;}, {&quot;name&quot;: &quot;Neural Classification&quot;, &quot;description&quot;: &quot;The process of categorizing data using neural network architectures.&quot;}, {&quot;name&quot;: &quot;Deep Learning&quot;, &quot;description&quot;: &quot;A subset of machine learning that uses multi-layered neural networks for complex data representation.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons&quot;, &quot;Activation Functions&quot;, &quot;Layers&quot;, &quot;Backpropagation&quot;, &quot;Loss Functions&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Game playing&quot;, &quot;Medical diagnosis&quot;]" />
        </attvalues>
      </node>
      <node id="Backpropagation" label="Backpropagation">
        <attvalues>
          <attvalue for="0" value="A key algorithm for training neural networks by minimizing the error through gradient descent." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Gradient Computation&quot;, &quot;description&quot;: &quot;The process of calculating the gradient of the loss function with respect to the model parameters.&quot;}, {&quot;name&quot;: &quot;Gradient Checking&quot;, &quot;description&quot;: &quot;A technique to verify the correctness of the gradient computation.&quot;}, {&quot;name&quot;: &quot;Backpropagation Software&quot;, &quot;description&quot;: &quot;Tools and libraries that implement backpropagation algorithms for training models.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of calculus, linear algebra, and neural networks." />
          <attvalue for="6" value="[&quot;Gradient Descent&quot;, &quot;Chain Rule&quot;, &quot;Loss Function&quot;]" />
          <attvalue for="7" value="[&quot;Backpropagation is the same as training a neural network.&quot;, &quot;It only works for feedforward networks.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Activation Functions" label="Activation Functions">
        <attvalues>
          <attvalue for="0" value="Functions that determine the output of a neural network node given an input or set of inputs." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Sigmoid Function&quot;, &quot;description&quot;: &quot;An activation function that maps any real-valued number into a value between 0 and 1.&quot;}, {&quot;name&quot;: &quot;Tanh Function&quot;, &quot;description&quot;: &quot;An activation function that maps values to a range between -1 and 1.&quot;}, {&quot;name&quot;: &quot;Softmax Classifier&quot;, &quot;description&quot;: &quot;An activation function used in multi-class classification problems to convert logits into probabilities.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of neural networks and calculus." />
          <attvalue for="6" value="[&quot;Sigmoid Function&quot;, &quot;ReLU (Rectified Linear Unit)&quot;, &quot;Tanh Function&quot;, &quot;Softmax Function&quot;]" />
          <attvalue for="7" value="[&quot;Activation functions are only used in the output layer.&quot;, &quot;All activation functions are the same.&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;, &quot;Game AI&quot;, &quot;Financial forecasting&quot;]" />
        </attvalues>
