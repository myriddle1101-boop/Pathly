      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="A computational model inspired by the human brain's network of neurons." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Convolutional Neural Networks&quot;, &quot;description&quot;: &quot;A type of neural network particularly effective for image processing.&quot;}, {&quot;name&quot;: &quot;Groups of Neurons&quot;, &quot;description&quot;: &quot;Clusters of neurons that work together to process information.&quot;}]" />
