      <node id="Vector Databases" label="Vector Databases">
        <attvalues>
          <attvalue for="0" value="Databases optimized for storing and retrieving vector embeddings." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Vector Search&quot;, &quot;description&quot;: &quot;Techniques for searching through vector databases.&quot;}, {&quot;name&quot;: &quot;Similarity Search&quot;, &quot;description&quot;: &quot;Finding similar vectors based on distance metrics.&quot;}]" />
