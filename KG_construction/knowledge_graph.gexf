    <nodes>
      <node id="Markov Chains" label="Markov Chains">
        <attvalues>
          <attvalue for="0" value="A mathematical system that undergoes transitions from one state to another on a state space." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Transition Matrix&quot;, &quot;description&quot;: &quot;A matrix that describes the probabilities of transitioning from one state to another.&quot;}, {&quot;name&quot;: &quot;Markov Property&quot;, &quot;description&quot;: &quot;The principle that the future state depends only on the current state, not on the sequence of events that preceded it.&quot;}, {&quot;name&quot;: &quot;Stationary Distribution&quot;, &quot;description&quot;: &quot;A probability distribution that remains unchanged as time passes in a Markov chain.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of probability and statistics." />
          <attvalue for="6" value="[&quot;State space&quot;, &quot;Transition probabilities&quot;, &quot;Markov property&quot;, &quot;Absorbing states&quot;]" />
          <attvalue for="7" value="[&quot;Markov chains are only for discrete states&quot;, &quot;Future states depend on more than just the current state&quot;]" />
          <attvalue for="8" value="[&quot;Predicting stock prices&quot;, &quot;Natural language processing&quot;, &quot;Game theory&quot;, &quot;Queueing systems&quot;]" />
        </attvalues>
      </node>
      <node id="Probabilities" label="Probabilities">
        <attvalues>
          <attvalue for="0" value="The measure of the likelihood that an event will occur." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Probability Matrix&quot;, &quot;description&quot;: &quot;A matrix that represents the probabilities of different outcomes.&quot;}, {&quot;name&quot;: &quot;Transition Probabilities&quot;, &quot;description&quot;: &quot;The probabilities associated with moving from one state to another in a Markov process.&quot;}, {&quot;name&quot;: &quot;Probability Vectors&quot;, &quot;description&quot;: &quot;Vectors that represent the probabilities of being in each state.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and algebra." />
          <attvalue for="6" value="[&quot;Random variables&quot;, &quot;Probability distributions&quot;]" />
          <attvalue for="7" value="[&quot;Probability is the same as certainty&quot;, &quot;Independent events do not affect each other&quot;]" />
          <attvalue for="8" value="[&quot;Risk assessment in finance&quot;, &quot;Machine learning model evaluation&quot;]" />
        </attvalues>
      </node>
      <node id="Eigenvalues and Eigenvectors" label="Eigenvalues and Eigenvectors">
        <attvalues>
          <attvalue for="0" value="Key concepts in linear algebra that are used in various machine learning algorithms." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Eigenvalue Magnitude&quot;, &quot;description&quot;: &quot;The absolute value of an eigenvalue, which can indicate the stability of a system.&quot;}, {&quot;name&quot;: &quot;Associated Eigenvalue&quot;, &quot;description&quot;: &quot;An eigenvalue that corresponds to a specific eigenvector.&quot;}, {&quot;name&quot;: &quot;Eigenvalue Multiplicity&quot;, &quot;description&quot;: &quot;The number of times an eigenvalue appears in the characteristic polynomial.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra, including matrices and vectors." />
          <attvalue for="6" value="[&quot;Matrix decomposition&quot;, &quot;Spectral theorem&quot;]" />
          <attvalue for="7" value="[&quot;Eigenvalues are always positive&quot;, &quot;Eigenvectors are unique&quot;]" />
          <attvalue for="8" value="[&quot;Principal Component Analysis (PCA)&quot;, &quot;Dimensionality reduction&quot;, &quot;Graph algorithms&quot;]" />
        </attvalues>
      </node>
      <node id="Clustering" label="Clustering">
        <attvalues>
          <attvalue for="0" value="A machine learning technique used to group similar data points together." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Clustering Properties&quot;, &quot;description&quot;: &quot;Characteristics that define how well a clustering algorithm performs.&quot;}, {&quot;name&quot;: &quot;Rationale Clustering&quot;, &quot;description&quot;: &quot;The reasoning behind choosing specific clustering methods for data analysis.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and linear algebra." />
          <attvalue for="6" value="[&quot;K-means clustering&quot;, &quot;Hierarchical clustering&quot;]" />
          <attvalue for="7" value="[&quot;Clustering is the same as classification&quot;, &quot;All clusters are spherical in shape&quot;]" />
          <attvalue for="8" value="[&quot;Customer segmentation&quot;, &quot;Image compression&quot;]" />
        </attvalues>
      </node>
      <node id="Graph Theory" label="Graph Theory">
        <attvalues>
          <attvalue for="0" value="The study of graphs, which are mathematical structures used to model pairwise relations between objects." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Transition Graphs&quot;, &quot;description&quot;: &quot;Graphs that represent the states and transitions of a Markov process.&quot;}, {&quot;name&quot;: &quot;Graph Models&quot;, &quot;description&quot;: &quot;Mathematical representations of real-world systems using graphs.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of discrete mathematics and familiarity with sets and functions." />
          <attvalue for="6" value="[&quot;Vertices and edges&quot;, &quot;Types of graphs (directed, undirected, weighted)&quot;]" />
          <attvalue for="7" value="[&quot;Graphs are only for computer science applications&quot;, &quot;All graphs must be connected&quot;]" />
          <attvalue for="8" value="[&quot;Social network analysis&quot;, &quot;Routing algorithms in computer networks&quot;]" />
        </attvalues>
      </node>
      <node id="Traffic Prediction" label="Traffic Prediction">
        <attvalues>
          <attvalue for="0" value="The use of algorithms to forecast traffic conditions based on historical data." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Congestion Prediction&quot;, &quot;description&quot;: &quot;Estimating traffic congestion levels in urban areas.&quot;}, {&quot;name&quot;: &quot;Road Traffic Analysis&quot;, &quot;description&quot;: &quot;The study of traffic patterns and behaviors on road networks.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of statistics and machine learning principles." />
          <attvalue for="6" value="[&quot;Time series analysis&quot;, &quot;Regression models&quot;, &quot;Data preprocessing&quot;, &quot;Feature engineering&quot;]" />
          <attvalue for="7" value="[&quot;Traffic prediction is always accurate&quot;, &quot;Only historical data is needed for predictions&quot;]" />
          <attvalue for="8" value="[&quot;Urban traffic management&quot;, &quot;Navigation apps&quot;, &quot;Public transportation scheduling&quot;, &quot;Event planning&quot;]" />
        </attvalues>
      </node>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Computational models inspired by the human brain, used for various machine learning tasks." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Activation Function&quot;, &quot;description&quot;: &quot;A function that determines the output of a neural network node.&quot;}, {&quot;name&quot;: &quot;Backpropagation&quot;, &quot;description&quot;: &quot;An algorithm for training neural networks by minimizing the error.&quot;}, {&quot;name&quot;: &quot;Loss Function&quot;, &quot;description&quot;: &quot;A function that quantifies the difference between predicted and actual outcomes.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of linear algebra and calculus, familiarity with programming concepts." />
          <attvalue for="6" value="[&quot;Neurons and Activation Functions&quot;, &quot;Feedforward and Backpropagation&quot;]" />
          <attvalue for="7" value="[&quot;Neural networks can learn without data&quot;, &quot;More layers always mean better performance&quot;]" />
          <attvalue for="8" value="[&quot;Image recognition&quot;, &quot;Natural language processing&quot;]" />
        </attvalues>
      </node>
      <node id="Reinforcement Learning" label="Reinforcement Learning">
        <attvalues>
          <attvalue for="0" value="A type of machine learning where an agent learns to make decisions by receiving rewards or penalties." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Theory of Reinforcement&quot;, &quot;description&quot;: &quot;The foundational principles that guide reinforcement learning algorithms.&quot;}, {&quot;name&quot;: &quot;Policy Optimization&quot;, &quot;description&quot;: &quot;The process of improving the decision-making policy of an agent.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of machine learning and probability theory." />
          <attvalue for="6" value="[&quot;Markov Decision Processes&quot;, &quot;Q-Learning&quot;]" />
          <attvalue for="7" value="[&quot;Reinforcement learning is the same as supervised learning&quot;, &quot;Rewards always lead to optimal behavior&quot;]" />
          <attvalue for="8" value="[&quot;Game playing (e.g., AlphaGo)&quot;, &quot;Robotics and automation&quot;]" />
        </attvalues>
      </node>
      <node id="Bike Sharing Systems" label="Bike Sharing Systems">
        <attvalues>
          <attvalue for="0" value="Urban transportation systems that allow users to rent bicycles for short periods." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Bike Stations&quot;, &quot;description&quot;: &quot;Locations where bicycles can be rented or returned.&quot;}, {&quot;name&quot;: &quot;Predicting Congestion&quot;, &quot;description&quot;: &quot;Forecasting demand and usage patterns in bike sharing systems.&quot;}]" />
          <attvalue for="2" value="2" />
          <attvalue for="3" value="Undergraduate" />
          <attvalue for="4" value="1-2 hours" />
          <attvalue for="5" value="Basic understanding of urban transportation systems and data analysis." />
          <attvalue for="6" value="[&quot;Bicycle rental models&quot;, &quot;User behavior analysis&quot;]" />
          <attvalue for="7" value="[&quot;Bike sharing is only for tourists&quot;, &quot;All bike sharing systems are the same&quot;]" />
          <attvalue for="8" value="[&quot;Urban planning and development&quot;, &quot;Sustainability initiatives&quot;]" />
        </attvalues>
      </node>
    </nodes>
