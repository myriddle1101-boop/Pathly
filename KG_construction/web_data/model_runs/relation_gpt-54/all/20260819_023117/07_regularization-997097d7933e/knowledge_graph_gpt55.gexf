    <nodes>
      <node id="Neural Networks" label="Neural Networks">
        <attvalues>
          <attvalue for="0" value="Fundamental structures in machine learning that mimic the way human brains operate." />
          <attvalue for="1" value="[{&quot;name&quot;: &quot;Deep Learning&quot;, &quot;description&quot;: &quot;A subset of neural networks with multiple layers for complex data representation.&quot;}, {&quot;name&quot;: &quot;Activation Functions&quot;, &quot;description&quot;: &quot;Functions that determine the output of a neural network node.&quot;}, {&quot;name&quot;: &quot;Hidden Units&quot;, &quot;description&quot;: &quot;The neurons in the hidden layers of a neural network.&quot;}]" />
